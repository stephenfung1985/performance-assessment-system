# 本机 / 服务器配置模板。复制成 .env 后再改：cp .env.example .env
# .env 不要进版本库。

# 服务端口
PORT=4000

# 登录态签名密钥。不改的话代码里会用硬编码默认值，启动日志每次都会告警，
# 任何人都能自己签一个合法 cookie。生成方法：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_SECRET=

# 只有整站跑在 https 后面才置 1；没有 https 时置 1 会导致登录态存不住
COOKIE_SECURE=0

# 数据目录。线上服务器务必设到代码文件夹之外，重新上传代码就不会覆盖数据；
# 备份目录自动放在它旁边（下例为 /var/lib/kaohe/backups）。本机不设，默认 server/data。
# 注意：systemd 的 EnvironmentFile 不认行尾注释，值后面不要跟 # 说明。
# DATA_DIR=/var/lib/kaohe/data

# 首次启动创建初始管理员用的账号密码。留空则用户名 admin、密码随机生成并打印到启动日志。
# SEED_ADMIN_USER=admin
# SEED_ADMIN_PASSWORD=

# ---------------- AI 解析导入（单井考核 › AI 导入资料） ----------------
# 不配 AI_PROVIDER 时只有「本地词典解析」可用（不出网）。配好后，上传资料中提取出的文字会发给下面的大模型，
# 界面上会提示「数据出网」；AI_BASE_URL 指向内网地址（10.x / 192.168.x / localhost）时视为私有化部署，不提示。
# 改完重启服务生效。密钥只在服务器上使用，不会下发到浏览器。
#
# 默认：DeepSeek（OpenAI 兼容协议）。填上 AI_API_KEY 即启用；AI_PROVIDER 留空则整体关闭。
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_API_KEY=
AI_VENDOR=DeepSeek
#
# 换厂商只改上面几行，例如：
#   通义千问（阿里云百炼）  AI_PROVIDER=openai  AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus  AI_VENDOR=通义千问
#   文心（百度千帆 v2）     AI_PROVIDER=openai  AI_BASE_URL=https://qianfan.baidubce.com/v2  AI_MODEL=ernie-4.0-turbo-8k  AI_VENDOR=文心一言
#   私有化 Ollama          AI_PROVIDER=openai  AI_BASE_URL=http://10.0.0.8:11434/v1  AI_MODEL=qwen2.5:32b  AI_API_KEY 留空
#   私有化 vLLM            AI_PROVIDER=openai  AI_BASE_URL=http://10.0.0.8:8000/v1  AI_MODEL=<部署时的模型名>
#   Claude                 AI_PROVIDER=anthropic  AI_BASE_URL=https://api.anthropic.com  AI_MODEL=claude-sonnet-5-5  AI_VENDOR=Claude
#                          （国内服务器通常直连不通，需要代理或中转地址）
# AI_PROVIDER 除 anthropic 外写什么都按 OpenAI 兼容协议调用（deepseek / qwen / openai 均可），只是个标记。
#
# 可选调节（一般不用动）：
# AI_TIMEOUT_MS=90000     单次调用超时（毫秒）
# AI_MAX_TOKENS=4096      模型最多输出多少 token
# AI_JSON_MODE=1          要求模型按 JSON 输出；个别私有化模型不支持 response_format 时设 0
# AI_MAX_FILE_MB=15       单个上传文件大小上限
# AI_MAX_CHARS=30000      单份资料最多取多少字参与解析（一次最多 3 倍于此）
# AI_MAX_EXAMPLES=12      每次解析带上最近多少条「生效」的纠正示例
