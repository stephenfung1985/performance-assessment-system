# 本机 / 服务器配置模板。复制成 .env 后再改：cp .env.example .env
# .env 不要进版本库。

# 服务端口
PORT=4000

# 登录态签名密钥。不改的话代码里会用硬编码默认值，启动日志每次都会告警，
# 任何人都能自己签一个合法 cookie。生成方法：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
JWT_SECRET=

# 只有整站跑在 https 后面才置 1；没有 https 时置 1 会导致登录态存不住
COOKIE_SECURE=0

# 数据目录。线上服务器务必设到代码文件夹之外，重新上传代码就不会覆盖数据；
# 备份目录自动放在它旁边（下例为 /var/lib/kaohe/backups）。本机不设，默认 server/data。
# 注意：systemd 的 EnvironmentFile 不认行尾注释，值后面不要跟 # 说明。
# DATA_DIR=/var/lib/kaohe/data

# 首次启动创建初始管理员用的账号密码。留空则用户名 admin、密码随机生成并打印到启动日志。
# SEED_ADMIN_USER=admin
# SEED_ADMIN_PASSWORD=
